# Notion Contact Form Integration
NOTION_API_KEY=ntn_your_notion_integration_secret_here
NOTION_DATABASE_ID=your_database_id_here
NOTION_FORM_FIRST_NAME_ID=title
NOTION_FORM_MIDDLE_NAME_ID=your_middle_name_property_id
NOTION_FORM_LAST_NAME_ID=your_last_name_property_id
NOTION_FORM_EMAIL_ADDRESS_ID=your_email_property_id
NOTION_FORM_PHONE_NUMBER_ID=your_phone_property_id
NOTION_FORM_MESSAGE_ID=your_message_property_id

# Google Analytics, GTM, Search Console & AdSense
# (Supports both NEXT_PUBLIC_ or raw prefixes)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_ID=google-site-verification-code
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXXX
GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
